<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos TextToSpeech SDK: speech through Pleos Connect's Speech Service. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- The device's TTS engine, used where there is no Pleos Speech Service (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roadio">

        <!-- Car API for the driving restrictions; not present on phones. -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Used while driving: one screen, large controls, no text input or scrolling (Android Automotive
                 distraction optimization). Without it the car shows a blocking screen when it moves. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
