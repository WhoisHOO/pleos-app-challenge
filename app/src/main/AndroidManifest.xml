<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pleos TextToSpeech SDK: speech through Pleos Connect's Speech Service. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- Pleos FusedLocation SDK: the car's position, asked for at run time after the in-app notice. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Pleos NaviHelper SDK: the story route to the car's navigation, and its next turn. -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- Pleos Vehicle SDK: the car's trip meter and odometer for the summary at the end of a drive (normal, granted at
         install). -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- The selected gear (GEAR_SELECTION): no story while reversing (normal, granted at install). -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- The media service stays in the foreground while a drive is on, so stories go on behind other apps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- The FusedLocation SDK asks for an automotive device; Roadio still runs a simulated drive on phones. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false"
        tools:replace="android:required" />

    <!-- The device's TTS engine, used where there is no Pleos Speech Service (Android 11+ package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".RoadioApp"
        android:allowBackup="false"
        android:appCategory="audio"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Roadio">

        <!-- Car API for the driving restrictions; not present on phones. -->
        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- Roadio opens its own screen from the car's launcher, besides being a source in the media centre. -->
        <meta-data
            android:name="androidx.car.app.launchable"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Used while driving: one screen, large controls, no text input or scrolling (Android Automotive
                 distraction optimization). Without it the car shows a blocking screen when it moves. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".media.RoadioMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- The Pleos media centre reads this from the service, not from the application. -->
            <meta-data
                android:name="androidx.car.app.launchable"
                android:value="true" />
        </service>
    </application>

</manifest>
